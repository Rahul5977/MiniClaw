# LLM provider (any OpenAI-compatible API). Defaults to local Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
# Only needed for cloud providers (OpenAI, Groq, OpenRouter...). Ollama ignores it.
OPENAI_API_KEY=

# --- Chat apps (`miniclaw gateway`) ---------------------------------------
# Telegram: create a bot with @BotFather; get your numeric id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# WhatsApp, official Cloud API (developers.facebook.com > your app > WhatsApp > API Setup).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any string you choose; enter the same value when configuring the webhook in Meta.
WHATSAPP_VERIFY_TOKEN=
# Numbers allowed to use the bot, with country code, comma-separated, e.g. 919876543210
WHATSAPP_ALLOWED_NUMBERS=

# WhatsApp, unofficial (Baileys, QR scan). Against WhatsApp's terms: use a spare number.
WHATSAPP_WEB_ENABLED=false
WHATSAPP_WEB_ALLOWED_NUMBERS=
